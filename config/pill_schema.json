{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PorannaPigulkaDnia",
  "type": "object",
  "required": [
    "date",
    "generated_at",
    "weather",
    "markets",
    "deadlines",
    "sections"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string",
      "minLength": 10
    },
    "weather": {
      "type": "object",
      "required": ["city", "status"],
      "properties": {
        "city": { "type": "string" },
        "postal_code": { "type": "string" },
        "status": { "type": "string", "enum": ["ok", "unavailable"] },
        "temp_now": { "type": ["number", "null"] },
        "apparent_temp": { "type": ["number", "null"] },
        "temp_min": { "type": ["number", "null"] },
        "temp_max": { "type": ["number", "null"] },
        "wind_speed_kmh": { "type": ["number", "null"] },
        "rain_probability_max": { "type": ["number", "null"] },
        "condition": { "type": "string" },
        "practical_tip": { "type": "string" },
        "hourly_forecast": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hour", "temp", "rain_prob"],
            "properties": {
              "hour": { "type": "string" },
              "temp": { "type": "number" },
              "rain_prob": { "type": "number" }
            }
          }
        },
        "error": { "type": "string" }
      }
    },
    "markets": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "partial", "unavailable"] },
        "table_no": { "type": "string" },
        "effective_date": { "type": "string" },
        "rates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "currency", "mid"],
            "properties": {
              "code": { "type": "string" },
              "currency": { "type": "string" },
              "mid": { "type": "number" }
            }
          }
        },
        "reference_rate": {
          "type": ["object", "null"],
          "properties": {
            "value_pct": { "type": "number" },
            "effective_from": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "source_url": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "deadlines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "title", "description", "tags"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "original_day": { "type": "integer" },
          "shifted": { "type": "boolean" },
          "days_remaining": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "items"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "unavailable", "empty"] },
          "status_message": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "headline",
                "summary",
                "tags",
                "importance",
                "relevance_for_profile",
                "details",
                "sources",
                "confidence"
              ],
              "properties": {
                "id": { "type": "string", "minLength": 2 },
                "headline": { "type": "string", "minLength": 5, "maxLength": 110 },
                "summary": { "type": "string", "minLength": 15 },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "importance": {
                  "type": "string",
                  "enum": ["high", "medium", "low"]
                },
                "relevance_for_profile": {
                  "type": "object",
                  "required": ["level", "reason"],
                  "properties": {
                    "level": {
                      "type": "string",
                      "enum": ["high", "medium", "low", "none"]
                    },
                    "reason": { "type": "string" }
                  }
                },
                "details": {
                  "type": "object",
                  "required": [
                    "what_happened",
                    "background",
                    "what_it_means_for_business",
                    "what_to_do",
                    "deadlines",
                    "caveats"
                  ],
                  "properties": {
                    "what_happened": { "type": "string", "minLength": 10 },
                    "background": { "type": "string", "minLength": 5 },
                    "what_it_means_for_business": { "type": "string", "minLength": 10 },
                    "what_to_do": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "deadlines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["date", "description"],
                        "properties": {
                          "date": { "type": "string" },
                          "description": { "type": "string" }
                        }
                      }
                    },
                    "caveats": { "type": "string" }
                  }
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["name", "url", "published"],
                    "properties": {
                      "name": { "type": "string" },
                      "url": { "type": "string" },
                      "published": { "type": "string" }
                    }
                  }
                },
                "confidence": {
                  "type": "string",
                  "enum": ["high", "medium", "low"]
                }
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "ai_model": { "type": "string" },
        "ai_calls": { "type": "integer" },
        "estimated_tokens": { "type": "integer" },
        "rejected_count": { "type": "integer" },
        "low_confidence_count": { "type": "integer" },
        "sources_status": { "type": "object" },
        "run_mode": { "type": "string" }
      }
    }
  }
}
