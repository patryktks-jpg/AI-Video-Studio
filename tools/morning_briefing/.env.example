# Konfiguracja środowiska dla Porannego Briefingu
# Skopiuj ten plik do .env i uzupełnij swoimi danymi:

# 1. Telegram (z @BotFather)
TELEGRAM_BOT_TOKEN=twoj_token_bota_tutaj
TELEGRAM_CHAT_ID=twoj_chat_id_tutaj

# 2. Gemini API (darmowy klucz z https://aistudio.google.com/)
GEMINI_API_KEY=twoj_klucz_gemini_tutaj

# 3. Twoje miasto do prognozy pogody
CITY=Warszawa
